{
  "name": "mooc-ai-helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MOOC 测验 AI 答题助手：控制台采集题目 -> 多模态大模型（含矩阵/微积分/概率统计计算工具）解题 -> 答案自动填回页面（不提交）",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "selftest": "node test/selftest.mjs",
    "mathtest": "node test/math-test.mjs",
    "realtest": "node test/real-test.mjs --paper examples/questions.json --expect examples/expected.json"
  },
  "engines": {
    "node": ">=18"
  }
}
