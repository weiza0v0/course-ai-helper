{
  "name": "course-ai-helper",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "在线课程 AI 答题助手（终端版）：一条命令连上浏览器，自动读题 → 多模态大模型（含自研矩阵/微积分/概率统计工具）解题 → 把答案填回页面或生成答案单。支持中国大学MOOC / 超星学习通 / 智慧树。永不自动提交。",
  "main": "cli.mjs",
  "scripts": {
    "start": "node cli.mjs",
    "list": "node cli.mjs --list",
    "selftest": "node cli.mjs --selftest",
    "mathtest": "node test/math-test.mjs",
    "realtest": "node test/real-test.mjs --paper examples/questions.json --expect examples/expected.json",
    "fetch-node": "node scripts/fetch-node.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "chaoxing",
    "xuexitong",
    "zhihuishu",
    "mooc",
    "icourse163",
    "llm",
    "education",
    "automation"
  ],
  "license": "MIT",
  "bin": {
    "course-ai-helper": "cli.mjs"
  }
}
